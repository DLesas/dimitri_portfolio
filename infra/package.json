{
  "name": "lesas-infra",
  "private": true,
  "description": "Pulumi project for lesas.dev's cloud resources",
  "main": "index.ts",
  "scripts": {
    "preview": "./pulumi.sh preview",
    "deploy": "./pulumi.sh up",
    "renew-key": "./pulumi.sh up --replace 'urn:pulumi:prod::lesas-infra::aws:appsync/apiKey:ApiKey::browser'",
    "outputs": "./pulumi.sh stack output"
  },
  "dependencies": {
    "@pulumi/aws": "^7.52.1",
    "@pulumi/pulumi": "^3.273.0",
    "@pulumiverse/vercel": "^5.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3"
  }
}
