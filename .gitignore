# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (here and in infra/ and infra/access/)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# infra/: compiled output, if tsc is ever run to emit (Pulumi itself compiles in memory)
/infra/**/bin/

# the site assistant's chunks, written before each build (scripts/ask/chunks.ts)
/src/generated/
