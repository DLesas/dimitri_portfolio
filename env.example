# What the site reads. Pulumi (infra/) sets all of these on the Vercel project, so with
# access to it `vercel env pull .env.local` fetches them. None of them are secrets.
# With none set, the site still runs: no live cursors, and the contact form logs
# submissions instead of sending them.

# Live cursors on the home page (infra/realtime.ts). Built into the browser bundle, so a
# change needs a rebuild.
NEXT_PUBLIC_REALTIME_HTTP_HOST=
NEXT_PUBLIC_REALTIME_WS_HOST=
NEXT_PUBLIC_REALTIME_API_KEY=

# The contact form (infra/email.ts). There's no AWS access key: on Vercel the function
# swaps its OIDC token for AWS_ROLE_ARN's credentials, and only production deployments
# can. Locally, leave AWS_ROLE_ARN empty to send with your own AWS credentials instead.
AWS_REGION=
AWS_ROLE_ARN=
SES_FROM_EMAIL=
CONTACT_EMAIL=
# The DynamoDB table counting each visitor's messages; without it there's no daily limit
CONTACT_LIMITS_TABLE=
